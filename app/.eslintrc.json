{
  "env": {
    "es2021": true,
    "node": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": [
    "airbnb-base"
  ],
  "settings": {
    "import/resolver": {
      "typescript": {},
      "node": {
        "extensions": [
          ".js",
          ".mjs",
          ".json"
        ]
      }
    }
  },
  "rules": {
    "import/no-extraneous-dependencies": ["error", {
        "devDependencies": [
            "**/*.test.js",
            "**/*.spec.js",
            "tests/**/*.js",
            "vitest.config.js",
            "vitest.config.{js,ts,mjs}"
        ]
      }
    ],
    "semi": [
      "error",
      "never"
    ],
    "no-useless-escape": "off",
    "import/prefer-default-export": "off",
    "no-tabs": "off", // autorise les tabulations
    "indent": [
      "error",
      "tab"
    ],
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "_id"
        ]
      }
    ], // valable que si la BDD est mongo
    "class-methods-use-this": "off",
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "js": "always",
        "mjs": "always"
      }
    ]

  }
}