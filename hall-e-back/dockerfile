FROM node:22-alpine

## Mysql
# Production
ARG PORT
ARG BDD_TARGET
ARG DB_PORT
ARG DB_USER
ARG DB_PASSWORD
ARG DB_NAME
ARG DB_HOST

ENV PORT=${PORT}
ENV BDD_TARGET=${BDD_TARGET}
ENV DB_PORT=${DB_PORT}
